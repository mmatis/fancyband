#!/usr/bin/env python3
"""Copy the manual's descriptions of races, classes, stats, and skills into
engine/lib/help/descriptions.txt, which the engine's GLOSSARY query reads.

The manual, engine/docs/birth.rst, does not ship with the game, and the
data files do not describe races, classes, stats, or skills. Every other
term GLOSSARY gives uses its data file's one-line description.

Usage: scripts/extract-descriptions [--check]
  --check   do not write; exit 1 if the file differs from what it would be
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DOCS = ROOT / "engine" / "docs"
OUT = ROOT / "engine" / "lib" / "help" / "descriptions.txt"

HEADER = """\
# Descriptions from the game's manual, engine/docs/birth.rst, for the GLOSSARY
# query. Written by scripts/extract-descriptions: do not edit by hand.
#
# Each entry starts with a line "@ id id ...", naming every term it
# describes. Each line after it, up to the next entry, is a paragraph.
"""

# birth.rst: each section's entries, by the term each describes. A
# section's entry is a line at the left margin with its text indented
# under it.
SECTIONS = {
    "Races": lambda name: "race:" + name,
    "Classes": lambda name: "class:" + name,
    "Stats": lambda name: "stat:" + name[:3].upper(),
    "Skills": None,
}

SKILLS = {
    "Infravision": ["skill:INFRA"],
    "Fighting": ["skill:TO_HIT_MELEE"],
    "Shooting Ability": ["skill:TO_HIT_BOW"],
    "Throwing Skill": ["skill:TO_HIT_THROW"],
    "Saving Throws": ["skill:SAVE"],
    "Stealth": ["skill:STEALTH"],
    "Disarming": ["skill:DISARM_PHYS", "skill:DISARM_MAGIC"],
    "Magical Devices": ["skill:DEVICE"],
    "Searching (Perception)": ["skill:SEARCH"],
}

def clean(text):
    """Join a paragraph's lines and drop the manual's markup."""
    text = " ".join(line.strip() for line in text.splitlines())
    text = re.sub(r"``([^`]*)``", r"\1", text)
    text = re.sub(r":[a-z]+:`([^`<]*?)(?:\s*<[^>]*>)?`", r"\1", text)
    text = re.sub(r"\*\*([^*]*)\*\*", r"\1", text)
    text = re.sub(r"\*([^*]*)\*", r"\1", text)
    return re.sub(r"\s+", " ", text).strip()


def birth_entries():
    """The race, class, stat, and skill entries of birth.rst."""
    lines = (DOCS / "birth.rst").read_text().splitlines()
    entries = {}
    section = None
    i = 0
    while i < len(lines):
        line = lines[i]
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        # A heading is a line underlined with "=".
        if line and re.fullmatch(r"=+", nxt) and len(nxt) >= len(line):
            section = line.strip() if line.strip() in SECTIONS else None
            i += 2
            continue
        if section and line and not line[0].isspace() and not line.startswith(".."):
            body = []
            i += 1
            while i < len(lines) and (not lines[i] or lines[i][0].isspace()):
                if not lines[i].strip() and body and i + 1 < len(lines) \
                        and lines[i + 1] and not lines[i + 1][0].isspace():
                    break
                body.append(lines[i])
                i += 1
            text = clean("\n".join(body))
            if not text:
                continue
            name = line.strip()
            if section == "Skills":
                ids = SKILLS.get(name)
                if ids is None:
                    sys.exit(f"birth.rst: skill {name!r} is not in SKILLS")
            else:
                ids = [SECTIONS[section](name)]
            for term in ids:
                entries.setdefault(term, []).append(text)
            continue
        i += 1
    return entries


def render(entries):
    # Terms with the same paragraphs share an entry.
    groups = {}
    for term, paras in entries.items():
        groups.setdefault(tuple(paras), []).append(term)
    out = [HEADER]
    for paras, terms in groups.items():
        out.append("@ " + " ".join(terms))
        out.extend(paras)
        out.append("")
    return "\n".join(out)


def main():
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] and not check:
        sys.exit("usage: scripts/extract-descriptions [--check]")
    entries = birth_entries()
    for kind, want in (("race", 11), ("class", 9), ("stat", 5)):
        got = sum(1 for t in entries if t.startswith(kind + ":"))
        if got != want:
            sys.exit(f"birth.rst: found {got} {kind} entries, want {want}")
    text = render(entries)
    if check:
        if not OUT.exists() or OUT.read_text() != text:
            sys.exit(f"{OUT.relative_to(ROOT)} does not match the manual; "
                     "run scripts/extract-descriptions")
        return
    OUT.write_text(text)


if __name__ == "__main__":
    main()
