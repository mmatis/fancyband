#!/usr/bin/env bash
# Build everything and run every test. Exits non-zero on the first failure.
#
# Usage: scripts/check [--clean]
#   --clean   delete the build directory first
#
# Environment:
#   BUILD_DIR   where the engine builds (default: build/engine)
#   JOBS        parallel build jobs (default: number of CPUs)

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${BUILD_DIR:-$root/build/engine}"
jobs="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}"

if [[ "${1:-}" == "--clean" ]]; then
	rm -rf "$build_dir"
elif [[ $# -gt 0 ]]; then
	echo "usage: scripts/check [--clean]" >&2
	exit 64
fi

step() { printf '\n==> %s\n' "$*"; }

step "Checking tools"
missing=()
for tool in cmake make cc perl python3 go; do
	command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [[ ${#missing[@]} -gt 0 ]]; then
	echo "missing required tools: ${missing[*]}" >&2
	exit 1
fi

step "Checking that engine code does not include UI headers"
"$root/scripts/check-layering"

step "Configuring engine in $build_dir"
mkdir -p "$build_dir"
cmake -S "$root/engine" -B "$build_dir" \
	-DSUPPORT_GCU_FRONTEND=ON \
	-DSUPPORT_NET_FRONTEND=ON \
	-DSUPPORT_TEST_FRONTEND=ON \
	-DSC_INSTALL=ON \
	>"$build_dir/configure.log" 2>&1 \
	|| { cat "$build_dir/configure.log" >&2; exit 1; }

step "Building engine"
cmake --build "$build_dir" -j "$jobs"

# The build copies the end-to-end tests next to the game only when the game
# binary relinks, so an edited test can go stale. Refresh the copy every run.
step "Refreshing end-to-end test files"
rm -rf "$build_dir/game/tests"
cp -R "$root/engine/tests" "$build_dir/game/tests"
cp "$root/engine/run-tests" "$build_dir/game/run-tests"

step "Running engine tests (unit and end-to-end)"
cmake --build "$build_dir" --target alltests

# The client's end-to-end tests play the engine just built over the net
# front end. Naming the binary makes them fail, not skip, if it is missing.
step "Checking Go client"
(
	cd "$root/client"
	export FANCYBAND_BIN="$build_dir/game/fancyband"
	go build ./...
	go vet ./...
	# -count=1 because a cached pass would hide a change to the engine.
	go test -count=1 ./...
)

# client/third_party/limoni is our fork of Limoni: run the tests of the
# packages it changes. See its FORK.md.
step "Checking the Limoni fork"
(
	cd "$root/client/third_party/limoni"
	go vet ./core/terminal ./graphics
	go test -count=1 ./core/terminal ./graphics
)

step "All checks passed"
